    "globals": "^15.14.0",
    "live-server": "^1.2.2",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.12",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{html,js,css,md}": [
      "prettier --write"
